{
  "name": "campusloop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,API\" -c \"cyan,magenta\" \"vite\" \"node server/index.js\"",
    "dev:frontend": "vite",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node server/test/e2e.test.js",
    "migrate": "node server/scripts/migrate.js",
    "migrate:seed": "node server/scripts/migrate.js --seed",
    "setup:db": "node server/scripts/setup-supabase.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  }
}
